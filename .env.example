# API Server Port
PORT=3000
HOST='http://localhost:3000'

# Database Configuration
DB_NAME='twizzy'
DB_USERNAME='your_mongodb_username'
DB_PASSWORD='your_mongodb_password'
DB_USERS_COLLECTION='users'
DB_REFRESH_TOKENS_COLLECTION='refresh_tokens'
DB_FOLLOWERS_COLLECTION='followers'
DB_TWIZZS_COLLECTION='twizzs'
DB_HASHTAGS_COLLECTION='hashtags'
DB_BOOKMARKS_COLLECTION='bookmarks'
DB_LIKES_COLLECTION='likes'
DB_CONVERSATIONS_COLLECTION='conversations'
DB_NOTIFICATIONS_COLLECTION='notifications'
DB_REPORTS_COLLECTION='reports'
DB_RECOMMENDATION_VIEWS_COLLECTION='recommendation_views'

# Security & Tokens
PASSWORD_SECRET='your_password_secret'
JWT_SECRET_ACCESS_TOKEN='your_jwt_access_secret'
JWT_SECRET_REFRESH_TOKEN='your_jwt_refresh_secret'
JWT_SECRET_EMAIL_VERIFY_TOKEN='your_jwt_email_verify_secret'
JWT_SECRET_FORGOT_PASSWORD_TOKEN='your_jwt_forgot_password_secret'
ACCESS_TOKEN_EXPIRES_IN='15m'
REFRESH_TOKEN_EXPIRES_IN='100d'
EMAIL_VERIFY_TOKEN_EXPRIRES_IN='7d'
FORGOT_PASSWORD_TOKEN_EXPRIRES_IN='7d'

# Google OAuth Configuration
GOOGLE_CLIENT_ID='your_google_client_id_for_web_oauth'
GOOGLE_CLIENT_SECRET='your_google_client_secret'
GOOGLE_REDIRECT_URI='http://localhost:3000/users/oauth/google'
CLIENT_REDIRECT_CALLBACK=''

# Nodemailer SMTP Email Setup
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT='587'
EMAIL_SECURE='false'
EMAIL_USER='your_email@gmail.com'
EMAIL_PASSWORD='your_gmail_app_password_16_chars'
EMAIL_FROM_NAME='Twizzy Support'

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME='your_cloudinary_cloud_name'
CLOUDINARY_API_KEY='your_cloudinary_api_key'
CLOUDINARY_API_SECRET='your_cloudinary_api_secret'

# Firebase Cloud Messaging Service Account (Path to JSON file)
GOOGLE_APPLICATION_CREDENTIALS='firebase-service-account.json'

# Gemini AI API Key (For recommendations/search)
GEMINI_API_KEY='your_gemini_api_key'



# Content Moderation Toggle (set to 'true' or leave empty)
MODERATE_TEXT=
MODERATE_IMAGE=
MODERATE_VIDEO=


